{
  "name": "halo-recipe-explorer",
  "version": "0.1.0",
  "private": true,
  "description": "Community recipe explorer for the Halo LLM training toolkit, deployed on Cloudflare Workers.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "og": "node scripts/render-og.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "deploy": "npx wrangler deploy"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "yaml": "2.9.1"
  }
}
